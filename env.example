# microCMSのサービスID（https://xxxx.microcms.io の xxxx の部分）
MICROCMS_SERVICE_DOMAIN=
# 読み込み用キー：GET と「下書きコンテンツの全取得」だけ許可
MICROCMS_API_KEY=
# 書き込み用キー：applications API の POST だけ許可（サーバー側でだけ使う）
MICROCMS_WRITE_KEY=
# 本番のURL（例：https://gakusei-kichi.jp）。検索結果やSNSに出るURLになる
SITE_URL=

# 上の読み込み用の2つが空のときは、サンプルデータで表示されます
